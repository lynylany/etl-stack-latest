      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT CASE WHEN f.discount = 0 THEN 'No Discount (0%)' WHEN f.discount <= 0.2 THEN 'Low (1-20%)' WHEN f.discount <= 0.4 THEN 'Medium (21-40%)' ELSE 'High (>40%)' END AS \"Discount Band\", SUM(f.quantity) AS \"Qty Sold\", SUM(f.sales) AS \"Revenue\", AVG(f.sales) AS \"Avg Line Sales\", SUM(f.profit) AS \"Profit\", ROUND((SUM(f.profit) / NULLIF(SUM(f.sales),0) * 100)::numeric, 2) AS \"Margin %\" FROM ecommerce.fact_sales f GROUP BY 1 ORDER BY MIN(f.discount);"
        }
      ]
